# --- Database (MySQL 8, docker-compose local) ---
DATABASE_URL="mysql://resorthub:hubpass@localhost:3307/resorthub"

# --- API ---
PORT=4000
NODE_ENV=development

# --- Auth ---
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="7d"

# OTP / SMS gateway (phase: auth)
SMS_PROVIDER="none"
SMS_API_KEY=""
SMS_API_SECRET=""

# --- Redis / jobs ---
REDIS_URL="redis://localhost:6380"

# --- Storage (room/activity photos) ---
S3_ENDPOINT=""
S3_BUCKET="resorthub-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Web apps ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"

# --- Email (SMTP) ---
# Gmail: host=smtp.gmail.com port=587 + App Password (2FA required)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- Guest payments (SSLCommerz) ---
# One integration covers bKash, Nagad, Rocket and cards in Bangladesh.
# Leave the store id blank and the mock gateway is used instead: the whole
# payment flow works, nothing real is charged, and no merchant account is
# needed to develop or demonstrate it.
#
# Opening the merchant account is the account owner's to do (see STATUS.md §5).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# 0 = sandbox (default), 1 = live. A boolean rather than a URL, so nobody can
# typo their way into charging real cards from a staging deployment.
SSLCOMMERZ_LIVE=0

# Where the gateway sends the guest back to, and where it posts the result.
PUBLIC_WEB_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:4000"
