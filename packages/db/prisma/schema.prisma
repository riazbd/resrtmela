generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN // platform team (us)
  RESORT_ADMIN // highest in-resort role, assigned by us
  MANAGER
  FRONT_DESK
  AGENT
  HOUSEKEEPING
  // No GUEST: since 2026-09-11 a guest is a row in a resort's register
  // (`Guest`), never an account. See 20260911110000_no_guest_accounts.
}

enum BookingKind {
  ROOM
  ACTIVITY
  PACKAGE
}


enum BookingState {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum CancelState {
  NONE
  REQUESTED // agent requested cancel -> admin queue
  APPROVED
  REJECTED
}

enum PaymentState {
  UNPAID
  PARTIAL
  PAID
}

enum RoomStatus {
  ACTIVE
  OUT_OF_SERVICE
}


enum ItemKind {
  ROOM
  ACTIVITY
  FB
  EXTRA_PERSON
}


enum PaymentType {
  ADVANCE
  FINAL
  REFUND
}

enum NotifChannel {
  SMS
  WHATSAPP
  PUSH
  EMAIL
}

// ───────────────────────── Tenancy ─────────────────────────

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  /// RESORT_OWNER | AGENCY — the two customers the platform sells to. Which one
  /// decides who is told about a bill and what a suspension does (a resort
  /// stops taking new entries; an agency stops selling).
  kind      String   @default("RESORT_OWNER") @db.VarChar(16)
  status    String   @default("active") @db.VarChar(16)
  /// "billing" when the sweep suspended the account, so the sweep may lift it
  suspendedReason String?   @db.VarChar(32)
  suspendedAt     DateTime?
  createdAt DateTime @default(now())
  resorts   Resort[]

  /// The subscription belongs to the account. `Tenant.plan` used to be a second
  /// answer to "what plan is this customer on" and is gone.
  subscriptions    Subscription[]
  subscriptionDues SubscriptionDue[]

  @@map("tenants")
}

model Resort {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String    @db.VarChar(160)
  location          String?   @db.VarChar(255)
  timezone          String    @default("Asia/Dhaka") @db.VarChar(64)
  currency          String    @default("BDT") @db.VarChar(8)
  locale            String    @default("en-IN") @db.VarChar(16) // number/date formatting; en-IN groups in lakh, which ICU's en-BD does not
  showRatesToAgents Boolean   @default(false)
  // agents planning a group need to see which nights are taken; whose
  // booking it is stays the resort's to give away, and starts closed
  showGuestNamesToAgents Boolean @default(false)
  /// the fallback when a resort has defined no tax rules; see TaxRule
  taxRatePct        Decimal   @default(0.00) @db.Decimal(5, 2)
  /// Business Identification Number — a VAT invoice in Bangladesh must show it
  binNumber         String?   @db.VarChar(32)
  agentPaymentHours Int       @default(48) // agent bookings must be fully paid this many hours before check-in

  /// What this resort pays its agents — one term for all of them.
  ///
  /// Commission used to be a per-agent field on `UserResort`, so two agents
  /// selling the same room could earn different money on it and no screen
  /// showed the spread. The owner's rule is that the rate belongs to the
  /// resort: one number, set by hand, that everyone sells on. The old
  /// per-agent columns still hold what each agent used to be on; nothing
  /// reads them for pricing any more.
  agentCommissionKind String  @default("PERCENT") @db.VarChar(8) // PERCENT (% of rent) | FLAT (per booking)
  agentCommissionRate Decimal @default(5.00) @db.Decimal(10, 2)
  invoicePrefix     String    @default("SER") @db.VarChar(12)
  bookingPrefix     String    @default("BK") @db.VarChar(12)
  fbPrefix          String    @default("RES") @db.VarChar(12)
  fyStartMonthDay   String    @default("07-01") @db.VarChar(5) // financial year start MM-DD
  checkInTime       String    @default("12:00 PM") @db.VarChar(16)
  checkOutTime      String    @default("10:00 AM") @db.VarChar(16)
  address           String?   @db.VarChar(255)
  website           String?   @db.VarChar(160)
  contactPhone      String?   @db.VarChar(32)
  status            String    @default("active") @db.VarChar(16)
  /// why the resort is not active: "billing" is the sweep's, anything else is a human's
  suspendedReason   String?   @db.VarChar(32)
  suspendedAt       DateTime?
  createdAt         DateTime  @default(now())

  roomTypes        RoomType[]
  rooms            Room[]
  ratePlans        RatePlan[]
  guests           Guest[]
  bookings         Booking[]
  activities       ActivityCatalog[]
  userResorts      UserResort[]
  auditLogs        AuditLog[]
  counters         Counter[]
  expenses         Expense[]
  fbBills          FbBill[]
  apiKeys          ApiKey[]
  discountOffers   DiscountOffer[]
  accessRequests   ResortAccess[]
  roles            CustomRole[]
  employees        Employee[]
  foodPackages     FoodPackage[]
  payrollPayments  PayrollPayment[]
  messageTemplates MessageTemplate[]
  options          ResortOption[]
  taxRules         TaxRule[]
  notificationJobs NotificationJob[]
  paymentIntents   PaymentIntent[]
  notifications    Notification[]
  emailCampaigns   EmailCampaign[]
  platformCharges  PlatformCharge[]
  creditOrders     EmailCreditOrder[]

  @@index([tenantId])
  @@map("resorts")
}

// staff & agents & guests-auth users
model User {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(160)
  /// Both required (2026-09-11): a person signs in with either, and the
  /// password reset mails a link. Stored as `normalizePhone` makes it — the
  /// form login looks it up by. Accounts that had none carry a placeholder
  /// (`placeholder-<id>`, `user-<id>@placeholder.invalid`) until a resort
  /// replaces it.
  phone         String     @unique @db.VarChar(32)
  email         String     @unique @db.VarChar(191)
  passwordHash  String?    @db.VarChar(255)
  role          Role
  status        String     @default("active") @db.VarChar(16)
  /// For AGENT users: the agency this person works under.
  ///
  /// There is no agency entity, only agent users, so an agency is the agent
  /// whose staff point at them. Null means "an agency in their own right".
  /// Without this, "my staff" could only be inferred from "shares a resort
  /// with me" -- which shows two agencies selling the same resort each other.
  parentAgentId Int?
  parentAgent   User?      @relation("AgencyStaff", fields: [parentAgentId], references: [id], onDelete: SetNull)
  agencyStaff   User[]     @relation("AgencyStaff")
  /// Permission set for an agency's staff. Null on an agency itself, which
  /// holds every agent permission by being the agency.
  agentRoleId   Int?
  agentRole     AgentRole? @relation(fields: [agentRoleId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  resorts         UserResort[]
  createdBookings Booking[]        @relation("BookingCreatedBy")
  agentBookings   Booking[]        @relation("BookingAgent")
  paymentsRecv    Payment[]        @relation("PaymentReceivedBy")
  auditLogs       AuditLog[]       @relation("AuditActor")
  wallet          Wallet?
  notifications   Notification[]
  accessRequests  ResortAccess[]
  emailCredits    EmailCredit?
  creditOrders    EmailCreditOrder[]
  campaigns       EmailCampaign[]
  agentRoles      AgentRole[]      @relation("AgencyRoles")
  agencyExpenses  Expense[]        @relation("AgencyExpenses")
  agencyHeads     ExpenseHead[]    @relation("AgencyExpenseHeads")
  agencyEmployees Employee[]       @relation("AgencyEmployees")
  agencyPayroll   PayrollPayment[] @relation("AgencyPayroll")
  agencyCounters  Counter[]        @relation("AgencyCounters")
  tourCategories  TourCategory[]   @relation("AgencyTourCategories")
  tourPackages    TourPackage[]    @relation("AgencyTourPackages")
  salesDocs       SalesDoc[]       @relation("AgencySalesDocs")
  passwordResets  PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        BigInt    @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the token we emailed; the token itself is never stored
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model UserResort {
  id             Int         @id @default(autoincrement())
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resortId       Int
  resort         Resort      @relation(fields: [resortId], references: [id], onDelete: Cascade)
  commissionRate Decimal?    @db.Decimal(10, 2) // agents only: percent value (PERCENT) or fixed ৳ (FLAT)
  commissionKind String      @default("PERCENT") @db.VarChar(8) // PERCENT (% of rent) | FLAT (fixed per booking)
  roleId         Int? // custom role (permissions matrix); null = legacy fixed role behaviour
  role           CustomRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, resortId])
  @@map("user_resorts")
}

/// Per-resort role with a permission matrix (Paradox-style: create user → pick role → tick permissions)
model CustomRole {
  id          Int      @id @default(autoincrement())
  resortId    Int
  resort      Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(60)
  permissions Json     @default("[]") // string[] of permission keys
  system      Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())

  users UserResort[]

  @@unique([resortId, name])
  @@map("roles")
}

// ───────────────────────── Payroll ─────────────────────────

/// Someone on a payroll. A resort has staff; so does a travel agency, and
/// paying them is the same act, so it is the same table with two possible
/// owners rather than two tables that drift apart.
model Employee {
  id          Int       @id @default(autoincrement())
  resortId    Int?
  resort      Resort?   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// set instead of resortId when the employer is a travel agency
  agencyId    Int?
  agency      User?     @relation("AgencyEmployees", fields: [agencyId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  phone       String?   @db.VarChar(20)
  designation String?   @db.VarChar(80)
  salary      Decimal   @default(0) @db.Decimal(10, 2)
  joinDate    DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  payments PayrollPayment[]

  @@index([resortId])
  @@index([agencyId])
  @@map("employees")
}

model PayrollPayment {
  id          Int            @id @default(autoincrement())
  resortId    Int?
  resort      Resort?        @relation(fields: [resortId], references: [id], onDelete: Cascade)
  agencyId    Int?
  agency      User?          @relation("AgencyPayroll", fields: [agencyId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String         @db.VarChar(7) // "2026-09"
  amount      Decimal        @db.Decimal(10, 2)
  method      String?       @db.VarChar(24)
  note        String?        @db.VarChar(255)
  paidAt      DateTime       @default(now())
  createdById Int?

  @@unique([employeeId, month])
  @@index([resortId, month])
  @@index([agencyId, month])
  @@map("payroll_payments")
}

// ───────────────────────── Restaurant packages ─────────────────────────

model FoodPackage {
  id        Int      @id @default(autoincrement())
  resortId  Int
  resort    Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  price     Decimal  @db.Decimal(10, 2)
  items     String?  @db.VarChar(500) // what's included, comma separated
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([resortId])
  @@map("food_packages")
}

/// Front-end CMS overrides (platform homepage text) — super admin edits.
model CmsSetting {
  key       String   @id @db.VarChar(60)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("cms_settings")
}

// ───────────────────────── Inventory ─────────────────────────

model RoomType {
  id                 Int     @id @default(autoincrement())
  resortId           Int
  resort             Resort  @relation(fields: [resortId], references: [id], onDelete: Cascade)
  name               String  @db.VarChar(120)
  maxAdults          Int     @default(2)
  maxChildren        Int     @default(0)

  /// What a NEW room of this type starts with. The room is what a booking reads.
  ///
  /// These used to be the answer: extra persons were allowed and priced per
  /// type. One type covers nine rooms at Sky Eco and they are not one size —
  /// some take a third bed, some do not, and the ones that do are not worth the
  /// same — so a single number here could not describe the inventory and the
  /// resort left the whole feature off. They are a starting point now, copied
  /// down when a room is created, so nobody types the same rate nine times.
  extraPersonAllowed Boolean @default(false)
  extraPersonRate    Decimal @default(0) @db.Decimal(10, 2)
  extraPersonMax     Int     @default(0)
  amenities          Json?
  active             Boolean @default(true)

  rooms          Room[]
  ratePlans      RatePlan[]
  discountOffers DiscountOffer[]

  @@index([resortId])
  @@map("room_types")
}

model Room {
  id         Int        @id @default(autoincrement())
  resortId   Int
  resort     Resort     @relation(fields: [resortId], references: [id], onDelete: Cascade)
  roomTypeId Int
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  name       String     @db.VarChar(120)
  baseRate   Decimal    @db.Decimal(10, 2)
  status     RoomStatus @default(ACTIVE)

  /// How many extra beds THIS room takes, and what each costs per night.
  ///
  /// Seeded from the room type when the room is created, and the room's own
  /// answer from then on: rooms of one type differ in size, which is the whole
  /// reason this moved off the type. A booking charges each extra person at the
  /// rate of the room they are actually in.
  extraPersonAllowed Boolean @default(false)
  extraPersonRate    Decimal @default(0) @db.Decimal(10, 2)
  extraPersonMax     Int     @default(0)

  /// Retired: out of the inventory, still in the history.
  ///
  /// A room with no stay behind it is deleted outright — it was a typo. A room
  /// that has been sold cannot be, because `booking_items.roomId` points at it
  /// and taking it away would take the rooms out of last year's bookings,
  /// invoices and reports. So it is retired: off the calendar, out of the plan
  /// cap, and its past intact. Distinct from `OUT_OF_SERVICE`, which means a
  /// room that is temporarily unsellable and still part of the inventory.
  deletedAt  DateTime?

  items          BookingItem[]
  nights         BookingNight[]
  fbBills        FbBill[]
  discountOffers DiscountOffer[]

  @@unique([resortId, name])
  @@index([resortId, deletedAt])
  @@map("rooms")
}

model RatePlan {
  id         Int      @id @default(autoincrement())
  resortId   Int
  resort     Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  dateFrom   DateTime @db.Date
  dateTo     DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  active     Boolean  @default(true)

  @@index([roomTypeId, dateFrom, dateTo])
  @@map("rate_plans")
}

model Guest {
  id            Int      @id @default(autoincrement())
  resortId      Int?
  resort        Resort?  @relation(fields: [resortId], references: [id], onDelete: Cascade)
  fullName      String   @db.VarChar(160)
  phone         String   @db.VarChar(32)
  nidPassportNo String?  @db.VarChar(64)
  email         String?  @db.VarChar(191)
  phoneKey      String   @db.Char(64) // sha256(normalizedPhone) dedup key
  createdAt     DateTime @default(now())
  isGuestUser   Boolean  @default(false) // has app login?

  bookings  Booking[]
  salesDocs SalesDoc[]

  /// One guest, one row. Without this two concurrent bookings for the same
  /// number — or an offline write replayed — each created their own, and the
  /// guest's history quietly split in two. A walk-in taken without a phone gets
  /// a key of its own rather than a hash of their name, because every walk-in
  /// called "local" was otherwise the same person.
  @@unique([resortId, phoneKey])
  @@index([resortId])
  @@map("guests")
}

// ───────────────────────── Bookings ─────────────────────────

model Booking {
  id           Int           @id @default(autoincrement())
  code         String        @db.VarChar(12) // BK-00001, per-resort sequence
  resortId     Int
  resort       Resort        @relation(fields: [resortId], references: [id])
  kind         BookingKind   @default(ROOM)
  guestId      Int
  guest        Guest         @relation(fields: [guestId], references: [id])
  createdById  Int?
  createdBy    User?         @relation("BookingCreatedBy", fields: [createdById], references: [id])
  agentUserId  Int?
  agentUser    User?         @relation("BookingAgent", fields: [agentUserId], references: [id])
  /// a code from this resort's BOOKING_SOURCE list; null means nobody recorded one
  source       String?       @db.VarChar(32)
  checkIn      DateTime?     @db.Date
  checkOut     DateTime?     @db.Date
  adults       Int           @default(2)
  children     Int           @default(0)
  extraPersons Int           @default(0) // extra guests beyond room capacity, charged at room type rate
  discount     Decimal       @default(0.00) @db.Decimal(10, 2)
  remarks      String?       @db.Text
  state        BookingState  @default(PENDING)
  cancelState  CancelState   @default(NONE) // agent cancel-request queue
  paymentState PaymentState  @default(UNPAID)
  groupTag     String?       @db.VarChar(24) // links N one-room bookings of a tour group
  bookedAt     DateTime      @default(now())
  invoiceNo    String?       @db.VarChar(20) // SER-00001, per-resort invoice counter
  invoiceAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime? // soft delete; never hard-delete history

  items    BookingItem[]
  payments Payment[]
  intents  PaymentIntent[]
  fbBills  FbBill[]

  @@unique([resortId, code])
  /// A VAT invoice with a duplicated serial is a problem with the VAT office,
  /// not a cosmetic one — and the resort's BIN is printed on it now.
  @@unique([resortId, invoiceNo])
  @@index([resortId, checkIn, checkOut])
  @@index([guestId])
  @@index([agentUserId])
  @@index([resortId, state, deletedAt])
  @@index([resortId, groupTag])
  @@map("bookings")
}

model BookingItem {
  id             Int           @id @default(autoincrement())
  bookingId      Int
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemKind       ItemKind      @default(ROOM)
  roomId         Int?
  room           Room?         @relation(fields: [roomId], references: [id])
  activitySlotId Int?
  activitySlot   ActivitySlot? @relation(fields: [activitySlotId], references: [id])
  fbBillId       Int?
  fbBill         FbBill?       @relation(fields: [fbBillId], references: [id], onDelete: SetNull)
  qty            Int           @default(1)
  unitPrice      Decimal       @db.Decimal(10, 2)

  nights BookingNight[]

  @@index([bookingId])
  @@map("booking_items")
}

/// THE double-booking guard: one row per night per room.
/// UNIQUE(roomId, night) makes overlapping stays physically impossible.
model BookingNight {
  id     Int         @id @default(autoincrement())
  itemId Int
  item   BookingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  roomId Int
  room   Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  night  DateTime    @db.Date

  @@unique([roomId, night])
  @@index([night])
  @@map("booking_nights")
}

// ───────────────────────── Activities ─────────────────────────

model ActivityCatalog {
  id          Int              @id @default(autoincrement())
  resortId    Int
  resort      Resort           @relation(fields: [resortId], references: [id], onDelete: Cascade)
  name        String           @db.VarChar(160)
  /// a code from this resort's ACTIVITY_CATEGORY list
  category    String?          @db.VarChar(32)
  basePrice   Decimal          @db.Decimal(10, 2)
  durationMin Int              @default(60)
  minPerSlot  Int              @default(1)
  maxPerSlot  Int              @default(10)
  description String?          @db.Text
  photos      Json?
  active      Boolean          @default(true)

  slots             ActivitySlot[]
  activitySchedules ActivitySchedule[]

  @@index([resortId])
  @@map("activity_catalog")
}

/// Weekly recurrence template — slots generated from these per date range.
model ActivitySchedule {
  id        Int             @id @default(autoincrement())
  catalogId Int
  catalog   ActivityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String          @db.VarChar(5) // "10:00" resort-local, treated as UTC clock
  endTime   String          @db.VarChar(5)
  capacity  Int             @default(10)
  active    Boolean         @default(true)

  @@index([catalogId])
  @@map("activity_schedules")
}

model ActivitySlot {
  id          Int             @id @default(autoincrement())
  catalogId   Int
  catalog     ActivityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int             @default(10)
  bookedCount Int             @default(0) // atomic guard: capacity - bookedCount >= n

  items BookingItem[]

  @@unique([catalogId, startsAt])
  @@index([startsAt])
  @@map("activity_slots")
}

// ───────────────────────── Money ─────────────────────────

model Payment {
  id           Int           @id @default(autoincrement())
  bookingId    Int
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       String        @default("CASH") @db.VarChar(24)
  paymentType  PaymentType   @default(ADVANCE)
  receivedById Int?
  receivedBy   User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime      @default(now())
  note         String?       @db.VarChar(255)
  /// client-generated id for a write that may be replayed (offline front desk)
  clientRef    String?       @db.VarChar(64)

  /// the guard against a replayed payment becoming a second receipt: scoped to
  /// the booking, so two devices cannot collide across different stays
  @@unique([bookingId, clientRef])
  @@index([bookingId])
  @@index([receivedAt])
  @@map("payments")
}

// ───────────────────────── Platform ops ─────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  resortId  Int?
  resort    Resort?  @relation(fields: [resortId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(32)
  entityId  BigInt?
  diff      Json?
  ip        Bytes?   @db.VarBinary(16)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

model NotificationJob {
  id           BigInt       @id @default(autoincrement())
  channel      NotifChannel
  toRef        String       @db.VarChar(64)
  template     String       @db.VarChar(64)
  dedupeKey    String?      @unique @db.VarChar(191)
  payload      Json?
  /// whose message this is: the resort whose wording and name it goes out in
  resortId     Int?
  resort   Resort? @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// exactly what was sent, so "what did the guest actually receive" has an answer
  renderedText String?      @db.Text
  sendAfter    DateTime     @default(now())
  sentAt       DateTime?
  attempts     Int          @default(0)
  lastError    String?      @db.Text

  @@index([sendAfter, sentAt])
  @@map("notification_jobs")
}

/// Daily operating expenses (resort-side, Bangla categories in `category`)
model Expense {
  id        Int          @id @default(autoincrement())
  resortId  Int?
  resort    Resort?      @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// set instead of resortId when the cost belongs to a travel agency
  agencyId  Int?
  agency    User?        @relation("AgencyExpenses", fields: [agencyId], references: [id], onDelete: Cascade)
  /// An agency files under heads it invented. The link is what reports group
  /// by, so renaming a head renames it everywhere; `category` keeps the name
  /// as it read on the day, which is what an exported CSV should say.
  headId    Int?
  head      ExpenseHead? @relation(fields: [headId], references: [id], onDelete: SetNull)
  date      DateTime     @db.Date
  category  String       @db.VarChar(120)
  details   String?      @db.VarChar(255)
  amount    Decimal      @db.Decimal(10, 2)
  scope     String       @default("RESORT") @db.VarChar(10) // RESORT | RESTAURANT
  createdBy Int?
  /// offline identity: the same entry replayed twice is still one entry
  clientRef String?      @db.VarChar(64)
  createdAt DateTime     @default(now())

  @@unique([agencyId, clientRef])
  /// The agency side had this and the resort side did not — and the resort side
  /// is the one with the offline front desk, so a replayed write made a second
  /// expense row.
  @@unique([resortId, clientRef])
  @@index([resortId, date])
  @@index([agencyId, date])
  @@map("expenses")
}

/// A heading a travel agency files its own costs under -- office rent, fuel,
/// commission paid out. The agency invents the list; the platform ships none,
/// because no two agencies keep books the same way.
model ExpenseHead {
  id        Int      @id @default(autoincrement())
  agencyId  Int
  agency    User     @relation("AgencyExpenseHeads", fields: [agencyId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([agencyId, name])
  @@map("expense_heads")
}

/// Restaurant / F&B bills (RES-##### sequence) — walk-in or charged to a stay
model FbBill {
  id         Int            @id @default(autoincrement())
  resortId   Int
  resort     Resort         @relation(fields: [resortId], references: [id], onDelete: Cascade)
  code       String         @db.VarChar(16) // RES-00001 per-resort sequence
  billDate   DateTime       @db.Date
  guestName  String?        @db.VarChar(160)
  bookingId  Int? // charge to a stay (nullable)
  booking    Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  roomId     Int? // room (optional, charge-to-room)
  room       Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  paidAmount Decimal        @default(0.00) @db.Decimal(10, 2)
  /// tax charged on this bill, recomputed from the resort's rules on every read
  /// and stored so a bill printed last year still says what it said
  taxAmount  Decimal        @default(0.00) @db.Decimal(10, 2)
  method     String?     @db.VarChar(24)
  note       String?        @db.VarChar(255)
  createdBy  Int?
  createdAt  DateTime       @default(now())
  deletedAt  DateTime?

  items        FbBillItem[]
  bookingItems BookingItem[]

  @@unique([resortId, code])
  @@index([resortId, billDate])
  @@map("fb_bills")
}

model FbBillItem {
  id        Int     @id @default(autoincrement())
  billId    Int
  bill      FbBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  name      String  @db.VarChar(120)
  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([billId])
  @@map("fb_bill_items")
}

/// Online payment checkout intents (bKash/Nagad-shaped, provider-agnostic)
model PaymentIntent {
  id          BigInt        @id @default(autoincrement())
  resortId    Int
  resort   Resort @relation(fields: [resortId], references: [id], onDelete: Cascade)
  bookingId   Int
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    String        @db.VarChar(24) // mock | bkash | nagad
  providerRef String        @unique @db.VarChar(64)
  amount      Decimal       @db.Decimal(10, 2)
  method      String      @db.VarChar(24)
  status      String        @default("pending") @db.VarChar(16) // pending | paid | failed | cancelled
  trxId       String?       @db.VarChar(64)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([bookingId])
  @@index([status])
  @@map("payment_intents")
}

/// Per-resort sequence generator for booking codes (avoids MAX race).
/// Every list a resort owns rather than the schema deciding for it: how it
/// takes money, where a booking came from, what kind of thing an activity is.
///
/// One table rather than one per list, because "make this dynamic" is a thing
/// that keeps happening — a bespoke table, service, controller and screen for
/// each would mean paying the same cost six times and getting six slightly
/// different behaviours. `list` names which list a row belongs to.
///
/// `meta` is where behaviour that used to be a `switch` over an enum goes. A
/// value is only dynamic if the *rules attached to it* are dynamic too;
/// otherwise the list is editable and the code still only understands the
/// values it shipped with.
/// What a resort adds to a bill, and on what.
///
/// `Resort.taxRatePct` was a single percentage on the whole booking, which
/// could not describe this market: Bangladesh charges 15% VAT, hotels here
/// commonly add a 10% service charge to the room that VAT is then charged on,
/// the restaurant is taxed at its own rate, and a menu price is usually quoted
/// with the VAT already inside it. The old column survives as the fallback for
/// a resort with no rules, and the migration turns a non-zero one into a rule.
model TaxRule {
  id        Int      @id @default(autoincrement())
  resortId  Int
  resort    Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  code      String   @db.VarChar(24)
  label     String   @db.VarChar(60)
  ratePct   Decimal  @db.Decimal(6, 3)
  /// ALL | ROOM | EXTRA_PERSON | ACTIVITY | FB
  appliesTo String   @default("ALL") @db.VarChar(16)
  /// already inside the listed price rather than added to it
  inclusive Boolean  @default(false)
  /// charged on the base plus the exclusive rules before it
  compound  Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resortId, code])
  @@index([resortId, active])
  @@map("tax_rules")
}

model ResortOption {
  id        Int      @id @default(autoincrement())
  resortId  Int
  resort    Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  list      String   @db.VarChar(32)
  code      String   @db.VarChar(32)
  label     String   @db.VarChar(60)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  /// per-value rules, shaped by the list — see options/registry.ts
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resortId, list, code])
  @@index([resortId, list, active])
  @@map("resort_options")
}

model Counter {
  id       Int     @id @default(autoincrement())
  resortId Int?
  resort   Resort? @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// set instead of resortId when an agency numbers its own documents
  agencyId Int?
  agency   User?   @relation("AgencyCounters", fields: [agencyId], references: [id], onDelete: Cascade)
  kind     String  @db.VarChar(16) // 'BOOKING' | 'QUOTATION' | 'INVOICE'
  nextVal  Int     @default(1)

  @@unique([resortId, kind])
  @@unique([agencyId, kind])
  @@map("counters")
}

// ───────────────────────── SaaS platform layer ─────────────────────────

/// A resort's platform subscription ("booking" the resort makes with the platform).
model Subscription {
  id          BigInt    @id @default(autoincrement())
  /// The customer — a resort owner or an agency — not one of its resorts.
  accountId   Int
  account     Tenant    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// PlatformPlan.name — a string, not an enum, so a new plan needs no migration
  plan        String    @default("STARTER") @db.VarChar(16)
  status      String    @default("TRIAL") @db.VarChar(16) // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  monthlyFee  Decimal   @db.Decimal(10, 2)
  startedAt   DateTime  @default(now())
  trialEndsAt DateTime?
  renewsAt    DateTime?
  cancelledAt DateTime?
  note        String?   @db.VarChar(255)

  /// A plan change that has been asked for but not paid for yet.
  ///
  /// A downgrade must not take the month away that the resort has already
  /// paid for, so it waits: this holds the plan the owner asked for, and the
  /// billing sweep applies it at the next renewal — the same pass that raises
  /// the first bill at the new price. NULL is the normal state.
  pendingPlan String?   @db.VarChar(16)

  dues SubscriptionDue[]

  /// One live subscription per account. The database enforces it with a
  /// generated column, `accountLiveKey` — the account id while the status is
  /// live, NULL once it is cancelled — under a unique index. It is deliberately
  /// not in this model: a column the application can write is a column the
  /// application can get wrong. See migrations 20260910140000_one_live_subscription
  /// and 20260912100000_the_subscriber_is_an_account.
  @@index([accountId])
  @@index([status])
  @@map("subscriptions")
}

/// One billing period the account owes the platform.
model SubscriptionDue {
  id             BigInt       @id @default(autoincrement())
  subscriptionId BigInt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Tenant       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  status         String       @default("DUE") @db.VarChar(16) // DUE | PAID | OVERDUE | WAIVED
  paidAt         DateTime?
  note           String?      @db.VarChar(255)

  /// the billing sweep is idempotent because of this line: a second run on the
  /// same period cannot raise a second bill, whatever the application does
  @@unique([subscriptionId, periodStart])
  @@index([status])
  @@index([accountId])
  @@map("subscription_dues")
}

enum WalletKind {
  TOPUP
  COMMISSION
  BOOKING_HOLD
  PAYOUT
  REFUND
  ADJUST
}

/// Per-user wallet (agents + resort owners).
model Wallet {
  id        Int         @id @default(autoincrement())
  userId    Int         @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  txns      WalletTxn[]

  @@map("wallets")
}

model WalletTxn {
  id           BigInt     @id @default(autoincrement())
  walletId     Int
  wallet       Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  kind         WalletKind
  amount       Decimal    @db.Decimal(12, 2) // signed: + credit, − debit
  balanceAfter Decimal    @db.Decimal(12, 2)
  bookingId    Int?
  note         String?    @db.VarChar(255)
  createdAt    DateTime   @default(now())

  @@index([walletId])
  @@map("wallet_txns")
}

/// API keys so a resort's own website can talk to the platform.
model ApiKey {
  id         BigInt    @id @default(autoincrement())
  resortId   Int
  resort     Resort    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(120)
  prefix     String    @unique @db.VarChar(24) // shown as rm_live_xxxx
  keyHash    String    @db.VarChar(128)
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resortId])
  @@map("api_keys")
}

/// Discount offers: per room type or resort-wide; auto-applied at booking time.
model DiscountOffer {
  id         Int       @id @default(autoincrement())
  resortId   Int
  resort     Resort    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// RESORT = every room · ROOM_TYPE = one category · ROOM = one particular room
  scope      String    @default("RESORT") @db.VarChar(10)
  roomTypeId Int?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  /// One specific room: the noisy one, the one facing the generator, the last
  /// one left on a slow Tuesday. Its identical neighbour keeps its own price.
  roomId     Int?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(120)
  kind       String    @default("PERCENT") @db.VarChar(8) // PERCENT | FLAT
  value      Decimal   @db.Decimal(10, 2)
  validFrom  DateTime?
  validTo    DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([resortId])
  @@map("discount_offers")
}

/// In-app notification (bell).
model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resortId  Int?
  resort   Resort? @relation(fields: [resortId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(160)
  body      String?   @db.VarChar(500)
  kind      String    @default("info") @db.VarChar(16) // info | booking | payment | alert | request
  link      String?   @db.VarChar(160)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Agent ↔ resort access request (agents discover resorts, owner approves).
model ResortAccess {
  id        BigInt    @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resortId  Int
  resort    Resort    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING") @db.VarChar(16) // PENDING | APPROVED | REJECTED
  note      String?   @db.VarChar(255)
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, resortId])
  @@map("resort_access")
}

/// Bulk email credits (sender.net style) — owner or agent buys packs, sends greetings.
model EmailCredit {
  id          BigInt    @id @default(autoincrement())
  userId      Int       @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits     Int       @default(0)
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("email_credits")
}

model EmailCampaign {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resortId   Int?
  resort   Resort? @relation(fields: [resortId], references: [id], onDelete: Cascade)
  subject    String   @db.VarChar(200)
  body       String   @db.Text
  recipients Int      @default(0)
  status     String   @default("SENT") @db.VarChar(16) // SENT | FAILED | PARTIAL
  sentAt     DateTime @default(now())

  @@index([userId])
  @@map("email_campaigns")
}

/// Editable subscription plan definitions (fees & limits) — super admin manages.
model PlatformPlan {
  id         BigInt  @id @default(autoincrement())
  name       String  @unique @db.VarChar(16) // STARTER | GROWTH | CHAIN
  label      String  @db.VarChar(40)
  monthlyFee Decimal @db.Decimal(10, 2)
  maxRooms   Int     @default(10)
  maxResorts Int     @default(1) // multi-resort gate: CHAIN allows several resorts per owner
  maxStaff   Int     @default(1) // "1 staff account" / "5 staff accounts" on the pricing card
  trialDays  Int     @default(14) // free trial length for this plan
  blurb      String? @db.VarChar(200)

  /// Which of `PLAN_FEATURES` this plan includes — a string[] of feature keys.
  ///
  /// JSON rather than a join table, following `CustomRole.permissions`: the
  /// list is short, always read whole, and validated against a code-declared
  /// vocabulary on the way in, so a key nobody implemented cannot be stored.
  ///
  /// These used to be a hardcoded map on the homepage keyed by plan name. A
  /// plan the owner created showed no features, and no line on any card locked
  /// anything.
  features   Json    @default("[]")

  /// RESORT | AGENCY — which shelf this plan is sold from. A resort never sees
  /// an agency plan and an agency never sees a resort plan.
  audience   String  @default("RESORT") @db.VarChar(16)

  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  /// The one plan the pricing page recommends. At most one row is true, which
  /// the service enforces — "at most one" is not something a unique index can
  /// say without storing NULL for false.
  highlight  Boolean @default(false)

  @@map("platform_plans")
}

/// Platform-wide policy the super admin edits: billing windows, notice periods,
/// the platform's own name on outgoing mail. Key/value because the alternative
/// is a column per decision and a migration every time one is added.
/// A one-off amount a tenant owes the platform, outside the subscription's
/// monthly rhythm: an email credit pack today; SMS packs, extra resorts and
/// setup fees are the same shape.
///
/// Deliberately not a SubscriptionDue. That table's UNIQUE(subscriptionId,
/// periodStart) is the only thing making the monthly billing sweep idempotent,
/// and two credit packs bought in one month would collide on it. Weakening the
/// index to fit one-off charges would trade recurring billing's one guarantee
/// for a convenience, so these carry their own identity instead: the reference
/// of the act that raised them.
/// A pack of email credits somebody has asked for, waiting on the platform.
///
/// Pressing a pack button used to grant the credits and raise the charge in
/// the same request: a misclick on the ৳12,000 pack was a ৳12,000 charge, and
/// a resort could bill itself without anyone at the platform agreeing. The
/// order sits here instead, and approval is the moment credits and charge
/// both come into being — in one transaction.
///
/// `price` is stored rather than looked up at approval time: what was quoted
/// when the request was made is what gets charged, whatever the price list
/// says by then.
model EmailCreditOrder {
  id          BigInt    @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// the resort the charge lands on, fixed when the order is placed
  resortId    Int
  resort      Resort    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  credits     Int
  price       Decimal   @db.Decimal(10, 2)
  status      String    @default("PENDING") @db.VarChar(16) // PENDING | APPROVED | REJECTED
  /// identity of the submit, so a retried request queues one order
  clientRef   String?   @db.VarChar(64)
  note        String?   @db.VarChar(255)
  decidedById Int?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([resortId, clientRef])
  @@index([status, createdAt])
  @@index([userId])
  @@map("email_credit_orders")
}

model PlatformCharge {
  id          BigInt    @id @default(autoincrement())
  resortId    Int
  resort      Resort    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  kind        String    @db.VarChar(24) // EMAIL_CREDITS | ...
  description String    @db.VarChar(160) // what a person would put on the invoice
  amount      Decimal   @db.Decimal(10, 2)
  status      String    @default("DUE") @db.VarChar(16) // DUE | PAID | WAIVED
  /// identity of the purchase, so a replayed request raises one charge
  clientRef   String?   @db.VarChar(64)
  createdById Int?
  paidAt      DateTime?
  note        String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())

  @@unique([resortId, clientRef])
  @@index([resortId, status])
  @@map("platform_charges")
}

model PlatformSetting {
  key       String   @id @db.VarChar(64)

  /// Text, not VARCHAR(255).
  ///
  /// Some settings are JSON — the credit-pack price list, the option-list
  /// defaults — and `updateSettings` used to `.slice(0, 255)` before writing.
  /// A list of more than about eight packs was cut mid-object, the parser fell
  /// back to the *shipped* prices, and the platform sold at rates the owner had
  /// never agreed to while the console reported the save as successful.
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// A resort's own wording for a message its guests receive.
///
/// Absent = the built-in wording is used, so a new resort works on day one and
/// nobody has to write eight messages before taking a booking.
model MessageTemplate {
  id        Int      @id @default(autoincrement())
  resortId  Int
  resort    Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  /// TemplateName — the message this replaces
  name      String   @db.VarChar(64)
  body      String   @db.VarChar(600)
  updatedAt DateTime @updatedAt

  @@unique([resortId, name])
  @@map("message_templates")
}

/// A permission set inside one agency.
///
/// Separate from CustomRole because that one is scoped to a resort, and an
/// agency's staff work across every resort the agency has been approved for —
/// a role scoped to a resort could not describe them.
model AgentRole {
  id          Int      @id @default(autoincrement())
  /// the agency that owns this role: an AGENT user with no parent
  agencyId    Int
  agency      User     @relation("AgencyRoles", fields: [agencyId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(60)
  permissions Json     @default("[]") // string[] of agent permission keys
  createdAt   DateTime @default(now())

  staff User[]

  @@unique([agencyId, name])
  @@map("agent_roles")
}

// --------------------- Agency: tours, quotations, invoices ---------------------

/// One node in an agency's own tree of what a tour is built from:
/// Transport -> Bus -> AC, Food -> Breakfast -> Set menu. Any depth, and the
/// platform ships no starting list: an agency that runs hill treks and one
/// that runs beach weekends do not buy the same things.
model TourCategory {
  id        Int            @id @default(autoincrement())
  agencyId  Int
  agency    User           @relation("AgencyTourCategories", fields: [agencyId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    TourCategory?  @relation("TourTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  TourCategory[] @relation("TourTree")
  name      String         @db.VarChar(80)
  active    Boolean        @default(true)
  sort      Int            @default(0)
  createdAt DateTime       @default(now())

  items TourPackageItem[]

  @@index([agencyId, parentId])
  @@map("tour_categories")
}

/// A package an agency sells: the tree's leaves picked out, priced, and given
/// a name. Cost sits beside price on every line, so an agency can see the
/// margin it is quoting rather than discovering it after the trip.
model TourPackage {
  id          Int      @id @default(autoincrement())
  agencyId    Int
  agency      User     @relation("AgencyTourPackages", fields: [agencyId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(160)
  summary     String?  @db.VarChar(500)
  days        Int      @default(1)
  nights      Int      @default(0)
  /// how many people the priced lines cover
  pax         Int      @default(1)
  active      Boolean  @default(true)
  clientRef   String?  @db.VarChar(64)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TourPackageItem[]
  docs  SalesDoc[]

  @@unique([agencyId, clientRef])
  @@index([agencyId])
  @@map("tour_packages")
}

model TourPackageItem {
  id         Int           @id @default(autoincrement())
  packageId  Int
  package    TourPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  /// the leaf this line was chosen from; kept nullable so deleting a category
  /// never destroys the packages already sold from it
  categoryId Int?
  category   TourCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  label      String        @db.VarChar(160)
  qty        Decimal       @default(1) @db.Decimal(10, 2)
  unitCost   Decimal       @default(0) @db.Decimal(10, 2)
  unitPrice  Decimal       @default(0) @db.Decimal(10, 2)
  sort       Int           @default(0)

  @@index([packageId])
  @@map("tour_package_items")
}

enum SalesDocKind {
  QUOTATION
  INVOICE
}

enum SalesDocStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  PAID
  VOID
}

/// A quotation or an invoice. One table, because an invoice is a quotation the
/// client said yes to: converting must carry every line across unchanged, and
/// two tables would mean copying between two shapes and getting it wrong.
///
/// The lines live on the document, not on the package it came from, so a
/// package repriced next month never rewrites a quote already sent.
model SalesDoc {
  id       Int            @id @default(autoincrement())
  agencyId Int
  agency   User           @relation("AgencySalesDocs", fields: [agencyId], references: [id], onDelete: Cascade)
  kind     SalesDocKind
  number   String         @db.VarChar(24) // QUO-000123 | INV-000123
  status   SalesDocStatus @default(DRAFT)

  clientName    String  @db.VarChar(160)
  clientEmail   String? @db.VarChar(191)
  clientPhone   String? @db.VarChar(32)
  clientAddress String? @db.VarChar(255)
  /// set when the client is someone the agency has already served
  guestId       Int?
  guest         Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  packageId Int?
  package   TourPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  issueDate  DateTime  @db.Date
  validUntil DateTime? @db.Date
  currency   String    @default("BDT") @db.VarChar(3)
  discount   Decimal   @default(0) @db.Decimal(10, 2)
  taxRate    Decimal   @default(0) @db.Decimal(5, 2) // percent
  amountPaid Decimal   @default(0) @db.Decimal(10, 2)
  notes      String?   @db.Text
  terms      String?   @db.Text

  /// the quotation this invoice was made from; one invoice per quotation
  convertedFromId Int?      @unique
  convertedFrom   SalesDoc? @relation("Conversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo     SalesDoc? @relation("Conversion")

  sentAt      DateTime?
  paidAt      DateTime?
  createdById Int?
  clientRef   String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items SalesDocItem[]

  @@unique([agencyId, number])
  @@unique([agencyId, clientRef])
  @@index([agencyId, kind, status])
  @@index([agencyId, guestId])
  @@map("sales_docs")
}

model SalesDocItem {
  id        Int      @id @default(autoincrement())
  docId     Int
  doc       SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(200)
  details   String?  @db.VarChar(500)
  qty       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice Decimal  @default(0) @db.Decimal(10, 2)
  sort      Int      @default(0)

  @@index([docId])
  @@map("sales_doc_items")
}
