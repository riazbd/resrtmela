{
  "expo": {
    "name": "Resort Mela",
    "slug": "resort-mela",
    "scheme": "resortmela",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#ffffff",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.resortmela.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#15803d"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.resortmela.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph guest ID documents, payment slips and room condition.",
        "NSPhotoLibraryUsageDescription": "Used to attach existing photographs to bookings and expenses."
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15803d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "consoleUrl": "https://resortmela.rootcodebd.com",
      "eas": {
        "projectId": "e3df03f7-f176-4c28-a47a-248a2bc70d97"
      }
    },
    "owner": "riaznur"
  }
}
